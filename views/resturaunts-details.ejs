<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Restaurant Details</title>
</head>

<body>
    <nav>
        <a href="/">Home</a> |
        <a href="/resturaunts">Restaurants</a>
    </nav>
    <hr>

    <h1>Resturaunt details</h1>

    <% if (resturaunt) { %>
        <h2>
            <%= resturaunt.name %>
        </h2>
        <p><strong>Address:</strong>
            <%= resturaunt.address %>
        </p>
        <p><strong>Status:</strong>
            <%= resturaunt.isOpen ? "Open Now" : "Closed" %>
        </p>
        <p><strong>Phone Number:</strong>
            <%= resturaunt.phone %>
        </p>
        <% } else { %>
            <h2>Resturaunt Not Found</h2>
            <p>The restaurant you are looking for does not exist.</p>
            <% } %>
</body>

</html>